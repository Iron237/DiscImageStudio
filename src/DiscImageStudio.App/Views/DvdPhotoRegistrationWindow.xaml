<Window x:Class="DiscImageStudio.Views.DvdPhotoRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiscImageStudio.Localization"
        Title="{loc:Text DvdCal.RegisterPhoto}" Width="1100" Height="850" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{loc:Text DvdCal.RegistrationHint}" TextWrapping="Wrap" FontSize="15"/>
            <TextBlock x:Name="ProgressText" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" Background="{DynamicResource Surface1Brush}" SizeChanged="Image_SizeChanged">
            <Image x:Name="Photo" Stretch="Uniform" MouseLeftButtonDown="Photo_Click"/>
            <Canvas x:Name="Overlay" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Text DvdCal.ResetPoints}" Click="Reset_Click" Padding="14,7" Margin="0,0,10,0"/>
            <Button Content="{loc:Text Xaml.Cancel}" IsCancel="True" Padding="14,7" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="{loc:Text DvdCal.SaveRegistration}" Click="Save_Click" IsEnabled="False" Padding="14,7"/>
        </StackPanel>
    </Grid>
</Window>
