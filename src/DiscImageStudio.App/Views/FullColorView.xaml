<UserControl x:Class="DiscImageStudio.Views.FullColorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             SizeChanged="View_SizeChanged">
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel Margin="{StaticResource PagePadding}">
            <controls:PageHeader Title="{loc:Text FullColor.Title}" Badge="BD-R · 64099"
                                 Workspace="{x:Static vm:Workspace.FullColor}" Hint="{loc:Text FullColor.Warning}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CompactButton}" Content="{loc:Text FullColor.BackDesign}" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Design}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource CompactButton}" Content="{loc:Text FullColor.NextExport}" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Export}" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>
            <TextBlock Text="{loc:Text FullColor.Warning}" Style="{StaticResource HintText}"
                       Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />
            <Grid x:Name="LayoutGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="360" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="PreviewPanel" Grid.Column="0" Margin="0,0,20,0">
                    <controls:SectionCard Header="{loc:Text FullColor.DesignSource}" IconKind="Image" Margin="0,0,0,16">
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <controls:SourceChip Text="{Binding SourceSummary}">
                                <controls:SourceChip.Actions>
                                    <Button Style="{StaticResource CompactButton}" Content="{loc:Text FullColor.BackDesign}"
                                            Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Workspace.Design}" />
                                </controls:SourceChip.Actions>
                            </controls:SourceChip>
                            <Image Source="{Binding InputPreview}" Height="150" Stretch="Uniform" Margin="0,10,0,0" />
                            <TextBlock Text="{loc:Text FullColor.DesignInputHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ToneSummary}" Style="{StaticResource CompactHint}" Margin="0,6,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{loc:Text FullColor.Generate}" Command="{Binding PreviewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Text FullColor.Calibration}" Command="{Binding CalibrationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Text FullColor.OpenPlan}" Command="{Binding OpenPlanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                            </WrapPanel>
                        </StackPanel>
                    </controls:SectionCard>
                    <controls:MonitorCard Title="{loc:Text FullColor.Compare}" IconKind="Rainbow" StatusText="{Binding PreviewState}" Margin="0,0,0,16">
                        <StackPanel Margin="12">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="6">
                                    <TextBlock Text="{loc:Text FullColor.Target}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Height="230">
                                        <Image Source="{Binding TargetPreview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="6">
                                    <TextBlock Text="{loc:Text FullColor.Predicted}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <Border Background="{DynamicResource Surface3Brush}" CornerRadius="6" Height="230">
                                        <Image Source="{Binding Prediction}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                            </UniformGrid>
                            <Expander Header="{loc:Text FullColor.Diagnostics}" Style="{StaticResource CardExpander}" Margin="0,10,0,0">
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="6"><TextBlock Text="{loc:Text FullColor.Original}" Style="{StaticResource FieldLabel}" />
                                        <Image Source="{Binding InputPreview}" Height="180" Stretch="Uniform" /></StackPanel>
                                    <StackPanel Margin="6"><TextBlock Text="{loc:Text FullColor.Residual}" Style="{StaticResource FieldLabel}" />
                                        <Image Source="{Binding ErrorPreview}" Height="180" Stretch="Uniform" /></StackPanel>
                                    <StackPanel Margin="6"><TextBlock Text="{loc:Text FullColor.NativeDither}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                        <Image Source="{Binding NativeDitherPreview}" Height="180" Stretch="Uniform" /></StackPanel>
                                    <StackPanel Margin="6"><TextBlock Text="{loc:Text FullColor.TextureDots}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                                        <Image Source="{Binding TexturePreview}" Height="180" Stretch="Uniform" /></StackPanel>
                                </UniformGrid>
                            </Expander>
                        </StackPanel>
                    </controls:MonitorCard>
                    <controls:SectionCard Header="{loc:Text FullColor.Output}" IconKind="FileDown">
                        <StackPanel>
                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <controls:PathField Label="{loc:Text FullColor.WorkDirectory}" Text="{Binding OutputRoot}" ButtonLabel="{loc:Text Xaml.Select}" Command="{Binding BrowseOutputCommand}" />
                                <CheckBox Content="{loc:Text FullColor.Accept}" IsChecked="{Binding AllowUnmeasured}" Margin="0,12,0,12" />
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="{loc:Text FullColor.Export}" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                <Button Content="{loc:Text FullColor.UseExistingIso}" Command="{Binding UseExistingIsoCommand}" Style="{StaticResource CompactButton}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <CheckBox Content="{loc:Text FullColor.UseForExport}" IsChecked="{Binding UseForExport}" IsEnabled="{Binding CanEdit}" Margin="0,12,0,0" />
                            <TextBlock Text="{loc:Text FullColor.OutputHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource CompactHint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </controls:SectionCard>
                </StackPanel>
                <StackPanel x:Name="Inspector" Grid.Column="1" IsEnabled="{Binding CanEdit}">
                    <controls:SectionCard Header="{loc:Text FullColor.Parameters}" IconKind="SlidersHorizontal">
                        <StackPanel>
                            <TextBlock Text="{loc:Text FullColor.GeometryOnly}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel>
                                <Button Content="{loc:Text FullColor.Save}" Command="{Binding SaveRecipeCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Text FullColor.Load}" Command="{Binding LoadRecipeCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,8" />
                                <Button Content="{loc:Text FullColor.Reset}" Command="{Binding ResetCommand}" Style="{StaticResource CompactButton}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Header="{Binding Title}" Style="{StaticResource CardExpander}" IsExpanded="True" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding Fields}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource CompactText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="{Binding Label}" Style="{StaticResource CompactTextBox}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:PathField Label="{loc:Text FullColor.Measurements}" Text="{Binding MeasurementsPath, UpdateSourceTrigger=PropertyChanged}"
                                                ButtonLabel="{loc:Text Xaml.Select}" Command="{Binding BrowseMeasurementsCommand}" Margin="0,16,0,0" />
                            <Button Content="{loc:Text FullColor.ClearMeasurements}" Command="{Binding ClearMeasurementsCommand}" Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <Expander Header="{loc:Text FullColor.Runtime}" Style="{StaticResource CardExpander}" Margin="0,16,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <controls:PathField Label="Python 3.10+" Text="{Binding PythonPath}" ButtonLabel="{loc:Text Xaml.Select}" Command="{Binding BrowsePythonCommand}" />
                                    <TextBlock Text="{loc:Text FullColor.RuntimeHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </controls:SectionCard>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
